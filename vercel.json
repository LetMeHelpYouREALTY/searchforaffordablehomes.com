{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "devCommand": "npm run dev",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "functions": {
    "app/**/*.tsx": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Image/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-featured-listings",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/my-sold-properties",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/my-home-value",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/home-valuation",
      "permanent": true
    },
    {
      "source": "/default.aspx",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/",
      "permanent": true
    },
    {
      "source": "/Default.aspx",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/",
      "permanent": true
    },
    {
      "source": "/property-search-map",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/property-search-map/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/rental/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/single-family/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/affordable-homes",
      "permanent": true
    },
    {
      "source": "/condo-townhouse/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/affordable-homes",
      "permanent": true
    },
    {
      "source": "/vacant-land/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/homes/sale/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/homes/(.*)",
      "has": [{ "type": "host", "value": "searchforaffordablehomes.com" }],
      "destination": "https://www.searchforaffordablehomes.com/listings",
      "permanent": true
    },
    {
      "source": "/my-featured-listings",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/my-sold-properties",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/my-home-value",
      "destination": "/home-valuation",
      "permanent": true
    },
    {
      "source": "/default.aspx",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Default.aspx",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/property-search-map",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/property-search-map/(.*)",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/rental/(.*)",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/single-family/(.*)",
      "destination": "/affordable-homes",
      "permanent": true
    },
    {
      "source": "/condo-townhouse/(.*)",
      "destination": "/affordable-homes",
      "permanent": true
    },
    {
      "source": "/vacant-land/(.*)",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/homes/sale/(.*)",
      "destination": "/listings",
      "permanent": true
    },
    {
      "source": "/homes/(.*)",
      "destination": "/listings",
      "permanent": true
    }
  ]
}
